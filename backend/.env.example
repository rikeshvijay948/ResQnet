# ==========================================
# ResQNet Backend Environment Configuration
# ==========================================

# Server Port (default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/resqnet?retryWrites=true&w=majority
# Note: If offline or unset, ResQNet automatically runs in resilient in-memory mode.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/resqnet?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=resqnet_super_secret_jwt_key_2026

# Allowed Frontend Origin (for CORS)
CLIENT_URL=http://localhost:5173
